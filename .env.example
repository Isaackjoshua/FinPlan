# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose.yml exposes it on 5433 so it does not clash with a local install)
DATABASE_URL=postgres://finplan:finplan_dev@localhost:5433/finplan
TEST_DATABASE_URL=postgres://finplan:finplan_dev@localhost:5433/finplan_test

# 32 random bytes, base64. Wraps every user's data key; losing it loses all financial data.
# Generate with: openssl rand -base64 32
DATA_MASTER_KEY=

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the web app
BETTER_AUTH_URL=http://localhost:3000

# Outgoing email. In development this points at Mailpit (inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=FinPlan <no-reply@localhost>

# --- Agent connections (milestone 4) ---
# Public address of the MCP endpoint that AI apps connect to.
MCP_URL=http://localhost:3001/mcp
MCP_PORT=3001
# Where the web app reaches the OAuth server. Never exposed to the internet.
AUTH_INTERNAL_URL=http://127.0.0.1:3002
AUTH_PORT=3002
# Shared by the web app and the OAuth server. Generate with: openssl rand -base64 32
AUTH_INTERNAL_SECRET=
