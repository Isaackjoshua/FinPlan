# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The name people will visit. Its DNS must point at this server before first start,
# and so must mcp.<that name>, which AI apps connect to.
# No domain yet? Use <server-ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
# (mcp.203-0-113-7.sslip.io then works with no extra setup).
DOMAIN=

# Generate each of these with: openssl rand -base64 32
# (POSTGRES_PASSWORD goes inside a URL: use `openssl rand -hex 24` for that one.)
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Shared by the website and the OAuth server.
AUTH_INTERNAL_SECRET=
# Wraps every user's data key. If it is lost, all financial data is unrecoverable.
# Keep a copy somewhere other than this server.
DATA_MASTER_KEY=

# Outgoing email for sign-up confirmation, e.g. smtps://USER:PASSWORD@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=FinPlan <no-reply@example.com>
