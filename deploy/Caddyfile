# Caddy obtains and renews the HTTPS certificate for this name automatically.
{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}

# The MCP endpoint that AI apps connect to. Kept on its own name so that it shares
# no cookies with the website.
mcp.{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy mcp:3001
}
